# Python
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Secrets / local config
.env
.env.*
!.env.example
.claude/settings.local.json
# Persisted UserConfig — holds hf_token in plaintext (app/config.py)
config-user.json
# Platform credentials store — VK token etc. (app/secrets.py)
secrets.json

# Server runtime artifacts
.gochidubb.pid
gochidubb.log
.coverage

# Runtime data
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
jobs_db/*.json
!jobs_db/.gitkeep
gochidubb.db
gochidubb.db-journal
*.sqlite
*.sqlite-journal

# User-supplied reference voices (may be private)
presets/voices/*.wav
presets/voices/*.mp3
!presets/voices/.gitkeep

# Bundled binaries
bin/ffmpeg*
bin/ffprobe*
bin/yt-dlp*

# Local scratch — notes, sample media, exploratory scripts
product.txt
selfware.toml
test.webm
test_audio.wav
# Exploratory scripts, not pytest tests (see CLAUDE.md)
tests/manual_test_*.py
# Working copies of the UI kept alongside the real one
static/*copy*.html

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
