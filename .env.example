# Copy to .env and fill in your own values

# Hugging Face token (only needed for speaker diarization)
# Get one at: https://huggingface.co/settings/tokens
# Then accept terms: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# VoxCPM model (default is fine)
VOXCPM_MODEL=openbmb/VoxCPM2
VOXCPM_CFG=2.0
VOXCPM_STEPS=10

# Ollama (only used when USE_LM_STUDIO=0)
OLLAMA_URL=http://localhost:11434

# ── LM Studio (translation backend) ──────────────────────────────────
USE_LM_STUDIO=1
# Any spelling works — with or without /v1, or even a full endpoint path.
# The client normalizes this to the host root and builds /api/v1/chat and
# /v1/models from it.
LM_STUDIO_URL=http://localhost:1234
# Leave empty to auto-pick an installed model.
LM_STUDIO_MODEL=
# Seconds to wait for one translation. Big thinking models on a cold start
# can take a minute for the first segment (model load + generation).
LM_STUDIO_TIMEOUT=300
# Output token budget per segment. Must comfortably exceed the translation
# itself — a thinking model spends tokens on reasoning first, and if the
# budget runs out mid-thought the response comes back with no answer at all.
LM_STUDIO_MAX_OUTPUT_TOKENS=2048
# Chain-of-thought setting for reasoning models: off | low | medium | high | on
# Translation doesn't benefit from reasoning, and "off" makes a thinking
# model dramatically faster. Ignored (with a warning) by models that don't
# support the setting. Set empty to leave the model's default alone.
LM_STUDIO_REASONING=off
# LM Studio serves one model instance at a time, so parallel requests just
# queue server-side while each one's timeout runs. 1 is the safe choice.
LM_STUDIO_MAX_CONCURRENT=1
# Context window override (0 = let LM Studio decide)
LM_STUDIO_CONTEXT_LENGTH=0

# UI auto-open on start (1=on, 0=off)
TACHIDUBB_OPEN_BROWSER=1

# Where the server listens. Loopback by default: there is NO authentication,
# so anything that can reach this port can read and delete your jobs. Set
# 0.0.0.0 only on a network you trust (the server warns at startup if you do).
TACHIDUBB_HOST=127.0.0.1
TACHIDUBB_PORT=8910
