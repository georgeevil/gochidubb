# ================================================================
# TachiDUBB Studio - Environment Configuration  (copy to .env)
# ================================================================
# Settings NOT listed here (VAD, auto-denoise, keep_background,
# wizard_mode, TTS_ENGINE, lip_sync) are per-job Form parameters or
# live in config-user.json (editable via the Settings tab in the UI).
# Only keys actually read by the code are listed below.
# ================================================================

# ================================================================
# TRANSLATION BACKEND
# ================================================================
# 1 = LM Studio (recommended), 0 = Ollama
USE_LM_STUDIO=1

# Any spelling works — with or without /v1, or even a full endpoint path.
# The client normalizes this to the host root and builds /api/v1/chat and
# /v1/models from it.
LM_STUDIO_URL=http://localhost:1234

# Leave empty to auto-pick an installed model.
LM_STUDIO_MODEL=

# Seconds to wait for one translation, calibrated for a single segment (i.e.
# for one LM_STUDIO_MAX_OUTPUT_TOKENS budget). Batches scale it up in
# proportion to how much they may have to generate, so you do not need to
# inflate this for batching. Big thinking models on a cold start can take a
# minute for the first segment (model load + generation).
LM_STUDIO_TIMEOUT=300

# Reasoning headroom per request, in output tokens. This is NOT the total
# budget: the translator adds its own estimate of the answer on top, so a
# batch of 16 lines asks for this plus ~1800. Sized purely for a thinking
# model's chain-of-thought, which it spends before writing any answer — if
# it runs out mid-thought the reply comes back with no answer at all, and
# the translator has to re-send the batch with a bigger budget.
#
# Measured on qwen/qwen3.6-27b: ~4100 reasoning tokens per request no
# matter whether the batch is 4, 8 or 16 lines. That cost is per REQUEST,
# not per line, which is a strong argument for larger batches on a
# thinking model — and for using a non-thinking one where you can.
LM_STUDIO_MAX_OUTPUT_TOKENS=4096

# Chain-of-thought setting for reasoning models: off | low | medium | high | on
# Translation doesn't benefit from reasoning, and "off" makes a thinking
# model dramatically faster. Ignored (with a warning) by models that don't
# support the setting. Set empty to leave the model's default alone.
LM_STUDIO_REASONING=off

# LM Studio serves one model instance at a time, so parallel requests can
# just queue server-side while each one's timeout runs. 1 is the safe choice
# and the only setting where TRANSLATE_CONTEXT_LINES is fully effective.
# That said, LM Studio 0.3.x does overlap requests to a loaded model:
# measured on qwen3-8b / Apple Silicon, 4 concurrent batches ran ~1.2x
# faster than 1. If you see no timeouts in the logs, try 2–4.
LM_STUDIO_MAX_CONCURRENT=1

# Context window override (0 = let LM Studio decide). Also used to auto-size
# translation batches — set it to the context length you actually loaded the
# model with (16384, 32768, …) and batches grow to match.
LM_STUDIO_CONTEXT_LENGTH=0

# ── Batched translation ─────────────────────────────────────────────
# Subtitles are translated many lines per request, not one line per request:
# a 10-minute video is ~150 segments, and one round trip each wastes both the
# context window and the model's prompt-processing time. Batching also gives
# the model the surrounding dialogue, so pronouns and terminology stay
# consistent between lines.
#
# Lines per request. 0 = auto-size from LM_STUDIO_CONTEXT_LENGTH (4–24).
# Larger is faster but a mis-formatted reply costs more to recover from —
# the batch is split in half and retried, down to single lines, so a bad
# reply is never trusted, just slower.
TRANSLATE_BATCH_SIZE=0

# Max source characters per request. 0 = auto. Guards against a batch of
# long monologue segments blowing past the context window.
TRANSLATE_BATCH_CHARS=0

# Lines of already-translated dialogue shown to the model as context (not
# re-translated). 0 disables. Only fully effective at LM_STUDIO_MAX_CONCURRENT=1,
# where the previous batch has finished before the next one is built.
TRANSLATE_CONTEXT_LINES=2

# Ollama URL (only used when USE_LM_STUDIO=0)
OLLAMA_URL=http://localhost:11434

# ================================================================
# TRANSCRIPTION (Whisper)
# ================================================================
# tiny | base | small | medium | large-v3
# base is recommended for CPU; large-v3 for GPU
WHISPER_MODEL=base

# ================================================================
# SPEAKER DIARIZATION (pyannote)
# ================================================================
# Hugging Face token — required for multi-speaker diarization.
# Get one at: https://huggingface.co/settings/tokens
# Then accept terms for BOTH:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
# Leave empty to skip diarization (single-speaker fallback is used).
# Also settable from System -> Setup, which applies it without a restart;
# "Run checks" there reports exactly which of the three steps is missing.
HF_TOKEN=

# ================================================================
# TTS (VoxCPM2)
# ================================================================
VOXCPM_MODEL=openbmb/VoxCPM2
VOXCPM_CFG=2.0          # 1.5-3.0, higher = closer to reference voice
VOXCPM_STEPS=10         # 5-20, lower = faster

# ================================================================
# SERVER / UI
# ================================================================
# Auto-open browser on startup (1=yes, 0=no)
TACHIDUBB_OPEN_BROWSER=1

# Where the server listens. Loopback by default: there is NO authentication,
# so anything that can reach this port can read and delete your jobs. Set
# 0.0.0.0 only on a network you trust (the server warns at startup if you do).
TACHIDUBB_HOST=127.0.0.1
TACHIDUBB_PORT=8910

# Pre-load VoxCPM at server start (1=on, 0=off).
# Off by default so the translation model gets the full GPU first.
TACHIDUBB_WARMUP=0

# ================================================================
# LIP-SYNC (optional, requires Wav2Lip)
# ================================================================
# If Wav2Lip is cloned outside the default search paths, set its dir:
# TACHIDUBB_WAV2LIP_DIR=/path/to/Wav2Lip

# ================================================================
# macOS / PyTorch COMPATIBILITY
# ================================================================
# Read by PyTorch itself - enables CPU fallback when MPS has gaps.
PYTORCH_ENABLE_MPS_FALLBACK=1
