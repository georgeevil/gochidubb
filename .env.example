# ================================================================
# TachiDUBB Studio - Environment Configuration  (copy to .env)
# ================================================================
# Settings NOT listed here (VAD, auto-denoise, keep_background,
# wizard_mode, TTS_ENGINE, lip_sync) are per-job Form parameters or
# live in config-user.json (editable via the Settings tab in the UI).
# Only keys actually read by the Python code are listed below.
# ================================================================

# ================================================================
# TRANSLATION BACKEND
# ================================================================
# 1 = LM Studio (recommended), 0 = Ollama
USE_LM_STUDIO=1

# LM Studio server URL (OpenAI-compatible /v1 base)
LM_STUDIO_URL=http://localhost:1234/v1

# Model to use (leave empty to auto-detect the first available).
# Large models on CPU (e.g. 27B) are slow per chunk — if you hit
# translation timeouts, use a smaller model or raise LM_STUDIO_TIMEOUT.
# LM_STUDIO_MODEL=Qwen/Qwen2.5-14B-Instruct

# Per-request timeout (seconds) for LM Studio translation calls.
# 60s (old default) caused timeouts on large CPU models; 300s is safe.
LM_STUDIO_TIMEOUT=300

# Max concurrent translation requests. LM Studio serves completions
# SERIALLY per model. 0 = auto (1 for >=20B models, 5 for smaller).
LM_STUDIO_MAX_CONCURRENT=0

# Number of segments to translate per LLM call (batch mode).
# Larger values = fewer API calls but harder to parse and more risk
# of the model losing track of segment boundaries. Default: 5, max: 15.
TRANSLATION_CHUNK_SIZE=5

# Ollama URL (only used when USE_LM_STUDIO=0)
OLLAMA_URL=http://localhost:11434

# ================================================================
# TRANSCRIPTION (Whisper)
# ================================================================
# tiny | base | small | medium | large-v3
# base is recommended for CPU; large-v3 for GPU
WHISPER_MODEL=base

# ================================================================
# SPEAKER DIARIZATION (pyannote)
# ================================================================
# Hugging Face token — required for multi-speaker diarization.
# Get one at: https://huggingface.co/settings/tokens
# Then accept terms: https://huggingface.co/pyannote/speaker-diarization-3.1
# Leave empty to skip diarization (single-speaker fallback is used).
HF_TOKEN=

# ================================================================
# TTS (VoxCPM2)
# ================================================================
VOXCPM_MODEL=openbmb/VoxCPM2
VOXCPM_CFG=2.0          # 1.5–3.0, higher = closer to reference voice
VOXCPM_STEPS=10         # 5–20, lower = faster

# ================================================================
# SERVER / UI
# ================================================================
# Auto-open browser on startup (1=yes, 0=no)
TACHIDUBB_OPEN_BROWSER=1

# Pre-load VoxCPM at server start (1=on, 0=off).
# Off by default so the translation model gets the full GPU first.
TACHIDUBB_WARMUP=0

# Verbose pipeline logging (1=on, 0=off). Emits DEBUG-level detail for
# every external API call. Turn on when a job breaks silently.
TACHIDUBB_DEBUG=0

# ================================================================
# LIP-SYNC (optional, requires Wav2Lip)
# ================================================================
# If Wav2Lip is cloned outside the default search paths, set its dir:
# TACHIDUBB_WAV2LIP_DIR=/path/to/Wav2Lip

# ================================================================
# macOS / PyTorch COMPATIBILITY
# ================================================================
# Read by PyTorch itself — enables CPU fallback when MPS has gaps.
PYTORCH_ENABLE_MPS_FALLBACK=1
